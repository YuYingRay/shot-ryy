{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": ["main", "main-*", "capture", "settings"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:path:default",
    "core:resources:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    {
      "identifier": "fs:read-files",
      "allow": [
        { "path": "$HOME/Pictures/**" },
        { "path": "$TEMP/**" },
        { "path": "$HOME/AppData/Local/Temp/**" },
        { "path": "$HOME/AppData/Roaming/Microsoft/Windows/Themes/**" },
        { "path": "$HOME/AppData/Local/Microsoft/Windows/Themes/**" },
        { "path": "C:/Windows/Web/**" },
        { "path": "$HOME/Library/Caches/shotstyle/tmp/**" },
        { "path": "/System/Library/Desktop Pictures/**" },
        { "path": "/Library/Desktop Pictures/**" }
      ]
    },
    "screenshots:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "log:default"
  ]
}
